{
  "$comment": "Single source of truth for extraction behaviour, loaded by every implementation. Keeping these as data rather than code is what stops the JavaScript and Python ports drifting apart. {{LETTER}}, {{NUMBER}} and {{UPPER}} are substituted per language: JavaScript uses \\p{Letter} with the u flag, Python uses [^\\W\\d_]; the two engines spell the same intent differently.",
  "version": "1.0.0",
  "thresholds": {
    "minSentenceChars": 40,
    "maxSentenceChars": 500,
    "maxCandidatesPerPage": 8,
    "maxPerType": 6,
    "maxEvidencePerClaim": 6,
    "supportThreshold": 0.18,
    "summaryDedupeThreshold": 0.72,
    "subsumedEvidenceRatio": 0.5,
    "minSummaryChars": 25,
    "repairSimilarityThreshold": 0.6,
    "uppercaseRatioLimit": 0.6,
    "minUppercaseSampleChars": 30
  },
  "claimPatterns": [
    [
      "certification",
      "\\b(ISO\\s?\\d{4,5}|SOC\\s?2|HIPAA|GDPR|FedRAMP|CMMC|PCI[- ]DSS|certified|accredited|audited|compliant with)\\b"
    ],
    [
      "statistic",
      "\\b\\d[\\d,.]*\\s?(%|percent|million|billion|thousand|users|customers|requests|ms|seconds|hours)\\b"
    ],
    [
      "pricing",
      "(\\$|€|£)\\s?\\d|\\bper\\s+(month|year|seat|user|request|token)\\b|\\bfree tier\\b"
    ],
    [
      "availability",
      "\\b(available in|supported regions|uptime|SLA|service level|99\\.\\d+%)\\b"
    ],
    [
      "credential",
      "\\b(patent(ed)?|trademark|licen[cs]ed|registered in)\\b"
    ],
    [
      "research",
      "\\b(we (show|measure|demonstrate|evaluate|find)|our (paper|study|research|experiments?)|peer[- ]reviewed|preprint)\\b"
    ],
    [
      "policy",
      "\\b(we (do not|never) (sell|share|store)|data (retention|residency)|privacy policy|terms of service)\\b"
    ],
    [
      "contact",
      "\\b[\\w.+-]+@[\\w-]+\\.[\\w.]{2,}\\b|\\bcontact us\\b"
    ],
    [
      "organization",
      "\\b(is|are)\\s+(an?|the)\\s+[^.]{0,60}\\b(company|organi[sz]ation|lab|laboratory|institute|agency|firm)\\b"
    ],
    [
      "product",
      "\\b(is|are)\\s+(an?|the)\\s+[^.]{0,60}\\b(platform|system|tool|service|library|framework|product|architecture|substrate)\\b"
    ],
    [
      "capability",
      "\\b(we|our\\s+\\w+|the\\s+(company|platform|system|tool|service|library|framework|product|organi[sz]ation|lab|laboratory|institute|agency|studio|firm|architecture|substrate))\\b[^.]{0,90}\\b(build|builds|building|built|develop|develops|developing|developed|provide|provides|providing|offer|offers|offering|deliver|delivers|delivering|operate|operates|operating|enable|enables|enabling|support|supports|supporting|run|runs|running|create|creates|creating|design|designs|designing|publish|publishes|publishing|maintain|maintains|maintaining|pair|pairs|pairing|focus|focuses|focusing|specialis|specializ)"
    ],
    [
      "technical_claim",
      "\\b(reasons?|verif(y|ies|ied)|infers?|derives?|validates?|proves?|guarantees?|ensures?)\\b[^.]{0,90}\\b(without|over|from|against|before)\\b"
    ],
    [
      "business_fact",
      "\\b(founded|headquartered|based in|established|incorporated|team of|since\\s+\\d{4})\\b"
    ]
  ],
  "atomicTypes": [
    "policy",
    "certification",
    "credential",
    "pricing",
    "statistic",
    "availability",
    "contact"
  ],
  "gates": {
    "$comment": "Each rejects a class of sentence that is grammatical but useless as a claim. Every one exists because it was observed in a real scan.",
    "selfReferential": "^(?:this|these|the)\\s+(?:privacy policy|terms|terms of service|agreement|document|section|table|figure|paper|study|article|page)\\b|^(?:table|figure|section|appendix)\\s+\\d|^the (?:document|section|chapter) that follows",
    "consentFormula": "^(?:by (?:using|accessing|continuing|clicking)|if you (?:do not )?(?:agree|accept)|you (?:agree|acknowledge|represent|warrant)\\b)|\\bcontinued use of the services\\b|\\bconstitutes acceptance\\b",
    "governedBy": "\\b(?:is|are) also governed by\\b|\\bentire agreement\\b|\\bwe may update this\\b|\\bdoes not apply to those third parties\\b",
    "danglingReference": "\\b(?:described|listed|set out|set forth|specified|outlined)\\s+(?:below|above|herein|in this (?:policy|section|agreement))\\b|\\bas follows\\b|\\bsee (?:section|table|figure)\\b",
    "obfuscatedValue": "\\[email\\s*protected\\]|\\[at\\]|\\(at\\)|&#\\d+;@",
    "namedCredential": "\\b(ISO\\s?\\d{4,5}|SOC\\s?2|HIPAA|GDPR|CCPA|FedRAMP|CMMC|PCI[- ]DSS|Type\\s?II|patent(?:\\s+no\\.?|\\s+number|ed\\b)|trademark|registered in|licen[cs]ed,? not sold|certificate|accreditation)\\b",
    "concretePricing": "(\\$|€|£)\\s?\\d|\\bper\\s+(month|year|seat|user)\\b|\\bfree tier\\b"
  },
  "sentences": {
    "splitAfter": {
      "source": "(?<=[.!?])\\s+(?=[A-Z0-9\"“'(])",
      "flags": "u"
    },
    "abbreviations": {
      "source": "\\b(?:Inc|Ltd|LLC|Co|Corp|plc|GmbH|Pty|No|Nos|vs|etc|e\\.g|i\\.e|cf|al|Fig|Dr|Mr|Mrs|Ms|Prof|St|Jr|Sr|Mt|Ave|approx|est|incl|min|max|sec|ms)\\.$",
      "flags": "i"
    },
    "initial": {
      "source": "\\b[A-Z]\\.$",
      "flags": "",
      "$comment": "Case-sensitive on purpose. Case-insensitively this also matches the 's.' in \"the substrate's.\", because the apostrophe creates a word boundary, and sentences ending in a possessive get joined to the next one."
    }
  },
  "html": {
    "skipElements": [
      "script",
      "style",
      "noscript",
      "template",
      "svg",
      "head",
      "iframe",
      "object",
      "canvas"
    ],
    "blockElements": [
      "h1",
      "h2",
      "h3",
      "h4",
      "p",
      "li",
      "blockquote",
      "dd",
      "figcaption",
      "td",
      "th"
    ],
    "sectioningElements": [
      "section",
      "article",
      "main",
      "div",
      "header",
      "aside",
      "nav",
      "footer"
    ],
    "separatingElements": [
      "br",
      "hr",
      "tr",
      "ul",
      "ol",
      "dl",
      "dt",
      "table",
      "figure",
      "address",
      "pre",
      "form",
      "label",
      "option",
      "h5",
      "h6"
    ]
  },
  "schemaTypeMap": {
    "Organization": "organization",
    "Corporation": "organization",
    "LocalBusiness": "organization",
    "Product": "product",
    "SoftwareApplication": "product",
    "Service": "service",
    "Person": "person",
    "Place": "location",
    "PostalAddress": "location",
    "ScholarlyArticle": "research",
    "Article": "documentation",
    "TechArticle": "documentation",
    "Offer": "pricing",
    "Course": "service",
    "Dataset": "documentation"
  }
}
